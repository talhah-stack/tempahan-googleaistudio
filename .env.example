# ===================================================
# KONFIGURASI SISTEM TEMPAHAN BILIK MESYUARAT
# ===================================================

# Konfigurasi Pangkalan Data MySQL (Pilihan: Jika menggunakan pelayan MySQL sebenar)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="bilik_mesyuarat_db"

# Port Pelayan Aplikasi
PORT=3000

# GEMINI_API_KEY: Disediakan secara automatik di persekitaran AI Studio jika diperlukan
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL aplikasi yang dihoskan
APP_URL="MY_APP_URL"
